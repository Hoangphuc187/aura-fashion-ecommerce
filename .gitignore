# ==============================================================
# AURA STUDIO - Comprehensive Production .gitignore
# Prevents accidental leakage of secrets, credentials & artifacts
# ==============================================================

# Secrets & Environment Variables (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12

# Database & Archives
*.db
*.sqlite
*.sqlite3
*.sql
*.bak
*.backup
*.dump
*.tar
*.gz
*.zip

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Production Builds
dist/
build/
*/dist/
*/build/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary & Test files
coverage/
.temp/
.cache/
