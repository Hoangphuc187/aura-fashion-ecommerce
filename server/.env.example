# ==============================================================
# AURA STUDIO - Environment Configuration Template
# COPY THIS FILE TO .env AND SET SECURE VALUES FOR PRODUCTION
# NEVER COMMIT .env TO VERSION CONTROL (GIT)
# ==============================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/clothing_store

# JWT Secret Key (Min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Secret Key for Stealth Admin Portal Access
ADMIN_SECRET_KEY=your_secure_random_admin_access_key

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:3000

# ==============================================================
# PAYMENT GATEWAYS (VNPAY & MOMO SANDBOX / PRODUCTION)
# ==============================================================

# VNPay Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payment/vnpay-return

# MoMo Gateway
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/gw_payment/transactionProcessor
MOMO_RETURN_URL=http://localhost:5000/api/payment/momo-return
MOMO_NOTIFY_URL=http://localhost:5000/api/payment/momo-ipn

# PayPal Gateway
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key
PAYPAL_CURRENCY=USD

# ==============================================================
# EMAIL SERVICE (SMTP)
# ==============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ==============================================================
# OAUTH AUTHENTICATION (GOOGLE & FACEBOOK)
# ==============================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
