# ==============================================================
# AURA STUDIO - Environment Configuration Template
# COPY THIS FILE TO .env AND SET SECURE VALUES FOR PRODUCTION
# NEVER COMMIT .env TO VERSION CONTROL (GIT)
# ==============================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/clothing_store
MONGODB_URI=mongodb://127.0.0.1:27017/clothing_store

# JWT Secret Key (Must be at least 32 characters of high entropy)
# In production, generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Secret Key for Stealth Admin Portal Access
ADMIN_SECRET_KEY=your_secure_random_admin_access_key

# Allowed Client URL for CORS
CLIENT_URL=http://localhost:3000

# Optional: AWS Configuration (For S3 media uploads)
# In AWS ECS/EC2, use IAM Roles instead of static keys!
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=aura-fashion-media-production
