{
  "name": "clothing-ecommerce-server",
  "version": "1.0.0",
  "description": "Backend API for Streetwear Fashion E-Commerce connected to MongoDB",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "seed": "node src/seed.js",
    "test": "node tests/test_security.js && node tests/test_realtime_and_worker.js",
    "test:realtime": "node tests/test_realtime_and_worker.js",
    "test:security": "node tests/test_security.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.12.1"
  }
}
